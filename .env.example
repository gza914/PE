# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql://doomwire:doomwire@localhost:5432/doomwire

# X API v2 — bearer token from developer.twitter.com
X_BEARER_TOKEN=

# Anthropic
ANTHROPIC_API_KEY=

# Optional overrides
CLAUDE_MODEL=claude-sonnet-4-6
POLL_INTERVAL_SECONDS=60
MAX_RESULTS_PER_USER=10
ANALYSIS_WINDOW_HOURS=6
ANALYSIS_BATCH_SIZE=50
